<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <StartupObject>BitDoFixer.Program</StartupObject>
    <RootNamespace>BitDoFixer</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <Version>0.1.0</Version>

    <!-- Permite restaurar y compilar un proyecto que apunta a Windows desde macOS o
         Linux. En Windows es un no-op. Sin esto, el build fuera de Windows falla con
         NETSDK1100. La app sigue sin poder EJECUTARSE fuera de Windows: ViGEm es un
         driver de kernel y DirectInput es COM. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- Solo al publicar: un build normal no es self-contained, para que el proyecto
       de tests pueda referenciar este proyecto (NETSDK1150).
       Publicar con: dotnet publish -c Release -r win-x64 -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="core\8bitdofixer.Core\8bitdofixer.Core.csproj" />
  </ItemGroup>

  <!-- El csproj vive en la raiz del repo, asi que el glob por defecto **/*.cs se
       traga los fuentes del proyecto de tests. Sin esta exclusion, la app intenta
       compilar los tests (y el markup compiler de WPF tambien). -->
  <ItemGroup>
    <Compile Remove="tests/**;core/**" />
    <None Remove="tests/**;core/**" />
    <Page Remove="tests/**;core/**" />
    <ApplicationDefinition Remove="tests/**;core/**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bluetooth DInput okuyup sanal Xbox koluna basmak için -->
    <PackageReference Include="MaterialDesignThemes" Version="5.3.0" />
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.*" />
    <PackageReference Include="SharpDX" Version="4.2.0" />
    <PackageReference Include="SharpDX.DirectInput" Version="4.2.0" />
  </ItemGroup>
</Project>
